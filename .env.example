# Required application configuration. Generate JWT_SECRET with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
JWT_SECRET=
# Exact browser origins, comma separated; no wildcard or automatic tunnel access.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
# Use 1 only when a trusted reverse proxy is the sole way to reach the API.
TRUST_PROXY_HOPS=0

DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=app
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/app?schema=public
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_USERNAME=
REDIS_PASSWORD=local-development-only

# Optional integrations. Missing values do not prevent startup.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
AWS_REGION=
AWS_S3_BUCKET=
# Leave both empty to use the AWS credential chain / IAM roles.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=5242880
FIREBASE_SERVICE_ACCOUNT=

# Used only by the explicit pnpm db:admin command; never seeded automatically.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
