# ── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
API_URL=http://localhost:8000
# Comma-separated extra origins to allow in CORS (localhost + ngrok/nip.io/sslip.io are always allowed)
CORS_ORIGINS=

# ── Database (Postgres via Prisma) ──────────────────────────────────────
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=app
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/app?schema=public

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=changeme
SALT_ROUNDS=10

# ── Redis (cache + BullMQ) ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_USERNAME=
REDIS_PASSWORD=changeme

# ── Email (optional — required for the email queue to actually deliver) ─
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── SMS via Twilio (optional) ────────────────────────────────────────────
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# ── File uploads via S3 (optional — required for /upload to work) ───────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Push notifications via Firebase (optional) ───────────────────────────
# Paste the full service account JSON as a single line.
FIREBASE_SERVICE_ACCOUNT=
