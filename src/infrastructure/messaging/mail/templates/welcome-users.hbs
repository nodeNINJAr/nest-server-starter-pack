<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Welcome to TACO</title>
</head>

<body style="font-family: Arial, sans-serif; background:#f4f6f8; padding:20px;">

    <table width="100%" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center">

                <table width="500" cellpadding="0" cellspacing="0"
                    style="background:#ffffff; padding:30px; border-radius:8px;">

                    <!-- HEADER -->
                    <tr>
                        <td align="center">
                            <h2 style="color:#333;">
                                Welcome to TACO, {{name}} 🎉
                            </h2>
                        </td>
                    </tr>

                    <!-- BODY -->
                    <tr>
                        <td style="font-size:14px; color:#444; line-height:1.6;">

                            <p>Hello <strong>{{name}}</strong>,</p>

                            <p>
                                Thank you for joining <strong>TACO</strong>. We’re excited to have you onboard.
                            </p>

                            <p>
                                With TACO, you can explore powerful tools and enjoy a smooth, reliable experience
                                designed to help you get more done.
                            </p>

                            <p>
                                Start exploring your dashboard and make the most of your journey today.
                            </p>

                        </td>
                    </tr>

                    <!-- CTA -->
                    <tr>
                        <td align="center" style="padding:25px 0;">
                            <a href="{{dashboardUrl}}" style="background:#2c7be5; color:#ffffff; padding:12px 24px;
                                text-decoration:none; border-radius:6px; font-weight:bold; display:inline-block;">
                                Go to Dashboard
                            </a>
                        </td>
                    </tr>

                    <!-- SUPPORT -->
                    <tr>
                        <td style="font-size:14px; color:#444; line-height:1.6;">

                            <p>
                                If you have any questions, feel free to reach out to our support team anytime.
                            </p>

                            <p style="margin-top:20px;">
                                Best regards,<br>
                                <strong>The TACO Team</strong>
                            </p>

                        </td>
                    </tr>

                </table>

                <!-- FOOTER -->
                <p style="color:#888; font-size:12px; margin-top:20px;">
                    © {{year}} TACO. All rights reserved.
                </p>

            </td>
        </tr>
    </table>

</body>

</html>